# ============================================================
# AegeanSense API - Environment Configuration
# ============================================================


# Local Docker Compose database password. On Railway, set DATABASE_URL to the
# Postgres service reference: ${{Postgres.DATABASE_URL}}
DB_PASSWORD=aegeansense_local_dev
# DATABASE_URL=postgresql://user:password@host:5432/database

# Batch sync settings (used whenever a sync is triggered for a FinotProfile)
SYNC_BATCH_DAYS=7            # Fetch history in N-day chunks
SYNC_START_DATE=2024-01-01   # How far back to sync historical data on first sync
SYNC_INTERVAL_HOURS=6        # Automatic incremental sync of all active profiles; 0 disables

# ============================================================
# Admin auth
# ============================================================

# Bootstraps the first admin account on startup (only used if admin_users is empty)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me

# Signs admin JWT bearer tokens - generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=720       # Token lifetime in minutes (default 12h)

# Encrypts FINoT profile passwords at rest (Fernet key) - generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# Browser origins allowed by CORS (comma-separated, with no trailing slash).
# Railway example: https://your-aegeansense-web.up.railway.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============================================================
# FINoT profiles
# ============================================================
# FINoT credentials are no longer set here. After starting the API, log in
# as admin (POST /api/admin/login) and create one profile per FINoT tenant
# via POST /api/admin/profiles.
